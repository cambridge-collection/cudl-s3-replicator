FROM public.ecr.aws/lambda/python:3.12

# Embed the Datadog Lambda Extension, which runs as a Lambda extension sidecar
# and is responsible for flushing metrics, traces, and logs to Datadog.
# Pin to a specific digest in production to avoid unexpected updates.
COPY --from=public.ecr.aws/datadog/lambda-extension:latest \
     /opt/extensions/ /opt/extensions/

# Copy and install dependencies first for better layer caching.
COPY requirements.txt requirements-datadog.txt ${LAMBDA_TASK_ROOT}/
RUN pip install --no-cache-dir -r ${LAMBDA_TASK_ROOT}/requirements-datadog.txt

COPY handler.py ${LAMBDA_TASK_ROOT}/

# Default entrypoint. When Datadog monitoring is enabled, override this via
# the Terraform image_config command to "datadog_lambda.handler.handler" and
# set DD_LAMBDA_HANDLER="handler.handler" in environment_variables.
CMD ["handler.handler"]
